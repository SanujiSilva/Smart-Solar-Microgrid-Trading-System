<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/solar_screen_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/solarToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:background="@drawable/solar_toolbar_background" android:elevation="0dp" app:title="@string/my_profile" app:titleTextAppearance="@style/Solar.ToolbarTitle" />
    <androidx.core.widget.NestedScrollView android:scrollbars="vertical" android:fadeScrollbars="true" android:scrollbarStyle="insideOverlay" android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/solar_scroll_thumb" android:id="@+id/screenScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:padding="@dimen/screen_padding">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:text="@string/my_profile" android:layout_marginBottom="@dimen/space_md" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/solar_hero_card" android:padding="@dimen/space_xl" android:layout_marginBottom="@dimen/space_lg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prosumer_home_eyebrow" android:textColor="@color/solar_accent" android:textSize="11sp" android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="@dimen/space_md" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Hero" android:text="@string/my_profile" android:textColor="#FFFFFF" android:layout_marginBottom="@dimen/space_sm" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:text="@string/profile_hero_hint" android:textColor="#F1ECFF" />
            </LinearLayout>
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:indeterminate="true" android:visibility="gone" app:indicatorSize="@dimen/progress_size" />
            <TextView android:id="@+id/messageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:layout_marginBottom="@dimen/space_md" android:accessibilityLiveRegion="polite" android:padding="@dimen/space_lg" android:background="@drawable/solar_banner_info" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reload_profile" app:icon="@drawable/ic_solar_profile" app:iconGravity="textStart" />
            <LinearLayout android:id="@+id/profileForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/profile_identity_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="@dimen/space_lg">
                        <TextView android:id="@+id/avatarText" android:layout_width="96dp" android:layout_height="96dp" android:textAppearance="@style/Solar.Text.Hero" android:textColor="@color/solar_primary" android:background="@drawable/solar_avatar" android:gravity="center" android:contentDescription="@string/profile_initial" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_lg" android:orientation="vertical">
                            <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Section" android:textColor="@color/solar_primary_dark" />
                            <com.google.android.material.chip.Chip android:id="@+id/accountStatusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:clickable="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Section" android:text="@string/profile_identity_heading" android:drawableStart="@drawable/ic_solar_profile" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_sm" />
                    <TextView android:id="@+id/identityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:textColor="@color/solar_primary_dark" android:lineSpacingExtra="5dp" android:background="@drawable/profile_identity_info_panel" android:padding="@dimen/space_lg" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/profile_contact_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Section" android:text="@string/edit_contact_heading" android:drawableStart="@drawable/ic_solar_profile" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_sm" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Support" android:text="@string/profile_contact_hint" android:background="@drawable/prosumer_blue" android:padding="@dimen/space_md" android:layout_marginBottom="@dimen/space_lg" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/full_name" app:startIconDrawable="@drawable/ic_solar_profile">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/fullNameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/button_height" android:inputType="textPersonName" android:singleLine="true" android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/email" app:startIconDrawable="@drawable/ic_solar_profile">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/button_height" android:inputType="textEmailAddress" android:singleLine="true" android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/phone" app:startIconDrawable="@drawable/ic_solar_profile">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/phoneInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/button_height" android:inputType="phone" android:singleLine="true" android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" style="@style/Widget.Solar.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_profile" app:icon="@drawable/ic_solar_profile" app:iconGravity="textStart" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/profile_account_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Section" android:text="@string/account_heading" android:drawableStart="@drawable/ic_solar_lock" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_md" />
                        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Support" android:text="@string/profile_account_card_hint" android:background="@drawable/prosumer_cream" android:padding="@dimen/space_lg" android:layout_marginBottom="@dimen/space_md" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/deactivateButton" style="@style/Widget.Solar.Button.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/request_deactivation" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/profile_session_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Section" android:text="@string/profile_session_action" android:drawableStart="@drawable/ic_solar_lock" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_md" />
                <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_out" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back_to_home" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/solar_bottom_nav_background" android:elevation="0dp" android:visibility="gone" app:labelVisibilityMode="labeled" app:itemIconTint="@color/solar_navigation" app:itemTextColor="@color/solar_navigation" app:menu="@menu/solar_navigation" />
</LinearLayout>
