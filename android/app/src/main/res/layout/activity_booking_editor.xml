<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/solar_screen_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/solarToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:background="@drawable/solar_toolbar_background" android:elevation="0dp" app:title="@string/booking_details" app:titleTextAppearance="@style/Solar.ToolbarTitle" />
    <androidx.core.widget.NestedScrollView android:scrollbars="vertical" android:fadeScrollbars="true" android:scrollbarStyle="insideOverlay" android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/solar_scroll_thumb" android:id="@+id/screenScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:padding="@dimen/screen_padding">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:text="@string/booking_details" android:layout_marginBottom="@dimen/space_md" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/solar_hero_card" android:padding="@dimen/space_xl" android:layout_marginBottom="@dimen/space_lg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prosumer_home_eyebrow" android:textColor="@color/solar_accent" android:textSize="11sp" android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="@dimen/space_md" />
                <TextView android:id="@+id/bookingCodeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/booking_code_placeholder" android:textAppearance="@style/Solar.Text.Section" android:textColor="@color/solar_surface" android:textSize="24sp" android:lineSpacingExtra="2dp" android:layout_marginBottom="@dimen/space_sm" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/booking_details_hint" android:textAppearance="@style/Solar.Text.Body" android:textColor="#F1ECFF" android:layout_marginBottom="@dimen/space_md" />
                <com.google.android.material.chip.Chip android:id="@+id/statusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:clickable="false" />
            </LinearLayout>
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:indeterminate="true" android:visibility="gone" app:indicatorSize="@dimen/progress_size" />
            <TextView android:id="@+id/messageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:layout_marginBottom="@dimen/space_md" android:accessibilityLiveRegion="polite" android:padding="@dimen/space_lg" android:background="@drawable/solar_banner_info" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/booking_summary_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/booking_summary_heading" android:textAppearance="@style/Solar.Text.Section" android:textColor="@color/solar_primary_dark" android:drawableStart="@drawable/ic_solar_booking" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_md" />
                    <TextView android:id="@+id/summaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:textColor="@color/solar_primary_dark" android:lineSpacingExtra="5dp" android:background="@drawable/booking_detail_info_panel" android:padding="@dimen/space_lg" android:layout_marginBottom="@dimen/space_sm" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/booking_action_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/booking_energy_heading" android:textAppearance="@style/Solar.Text.Section" android:drawableStart="@drawable/ic_solar_station" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_sm" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/amountLayout" style="@style/Widget.Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/energy_kwh" android:layout_marginTop="@dimen/space_sm">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/amountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/button_height" android:inputType="numberDecimal" android:singleLine="true" android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/rescheduleButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/change_booking_slot" app:icon="@drawable/ic_solar_station" app:iconGravity="textStart" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" style="@style/Widget.Solar.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_booking" app:icon="@drawable/ic_solar_profile" app:iconGravity="textStart" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/booking_actions_panel" android:padding="@dimen/space_xl" android:elevation="3dp" android:layout_marginBottom="@dimen/space_lg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/booking_actions_heading" android:textAppearance="@style/Solar.Text.Section" android:drawableStart="@drawable/ic_solar_qr" android:drawablePadding="@dimen/space_sm" android:layout_marginBottom="@dimen/space_md" />
                <com.google.android.material.button.MaterialButton android:id="@+id/qrButton" style="@style/Widget.Solar.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/show_qr" android:visibility="gone" app:icon="@drawable/ic_solar_qr" app:iconGravity="textStart" />
                <com.google.android.material.button.MaterialButton android:id="@+id/cancelButton" style="@style/Widget.Solar.Button.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancel_booking" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/refreshButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reload_booking" app:icon="@drawable/ic_solar_station" app:iconGravity="textStart" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bookingsButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/my_bookings" app:icon="@drawable/ic_solar_booking" app:iconGravity="textStart" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back_action" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

