<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/prosumer_activity_item"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/reservationCodeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/Solar.Text.Section"
            android:textColor="@color/solar_primary_dark"
            android:textSize="14sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:textSize="11sp"
            app:chipMinHeight="32dp"
            app:chipStrokeWidth="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/reservationTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/Solar.Text.Support" />

    <TextView
        android:id="@+id/energyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/prosumer_mint"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textAppearance="@style/Solar.Text.Body"
        android:textColor="@color/solar_success" />
</LinearLayout>
