<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/solar_screen_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/solarToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:background="@drawable/solar_toolbar_background" android:elevation="0dp" app:title="@string/station_directory_title" app:titleTextAppearance="@style/Solar.ToolbarTitle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding">
        <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:text="@string/station_directory_title" android:layout_marginBottom="@dimen/space_md" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/solar_hero_card" android:padding="@dimen/space_xl" android:layout_marginBottom="@dimen/space_lg">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prosumer_home_eyebrow" android:textColor="@color/solar_accent" android:textSize="11sp" android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="@dimen/space_md" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Hero" android:textColor="#FFFFFF" android:text="@string/station_directory_title" android:layout_marginBottom="@dimen/space_sm" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:textColor="#F1ECFF" android:text="@string/station_directory_hint" android:layout_marginBottom="@dimen/space_lg" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Solar.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_stations">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/button_height" android:inputType="text" android:singleLine="true" android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/searchButton" style="@style/Widget.Solar.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_action" app:icon="@drawable/ic_solar_station" app:iconGravity="textStart" />
        </LinearLayout>
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:indeterminate="true" android:visibility="gone" app:indicatorSize="@dimen/progress_size" />
        <TextView android:id="@+id/messageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Body" android:layout_marginBottom="@dimen/space_md" android:accessibilityLiveRegion="polite" android:padding="@dimen/space_lg" android:background="@drawable/solar_banner_info" android:visibility="gone" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/station_results_hint" android:textAppearance="@style/Solar.Text.Support" android:paddingHorizontal="@dimen/screen_padding" android:layout_marginBottom="@dimen/space_sm" />
    <androidx.recyclerview.widget.RecyclerView android:scrollbars="vertical" android:fadeScrollbars="true" android:scrollbarStyle="insideOverlay" android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/solar_scroll_thumb" android:id="@+id/results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="@dimen/screen_padding" android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_lg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding">
        <TextView android:id="@+id/pageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Solar.Text.Support" android:layout_marginBottom="@dimen/space_md" />
        <com.google.android.material.button.MaterialButton android:id="@+id/previousButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/previous_page" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/nextButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_page" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back_to_home" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
